# book_alerter environment configuration.
#
# Copy to .env and fill in the values you need. Every variable is optional —
# the container ships with sensible defaults (paths under /app/data, ntfy
# disabled, no auth). The .env file is gitignored; .env.example is the
# canonical reference.

# ---------------------------------------------------------------------------
# Bind-mount ownership.
#
# The container drops to a non-root UID at startup and writes SQLite under
# /app/data, which is bind-mounted from ./data on the host. If the container
# UID doesn't own the host directory, every INSERT fails with "attempt to
# write a readonly database". Set PUID/PGID to the host owner of ./data —
# usually the output of `id -u` / `id -g` for the user that ran
# `docker compose up`. Defaults (1000:1000) match a typical single-user
# Linux host; override on macOS, multi-user boxes, or NAS systems
# (Synology default is 1026:100, Unraid is 99:100, etc.).
# ---------------------------------------------------------------------------

# PUID=1000
# PGID=1000

# ---------------------------------------------------------------------------
# Container paths (defaults in Dockerfile match what the data volume expects;
# only override if you remap the volume).
# ---------------------------------------------------------------------------

# SQLite database URL. Default: sqlite:////app/data/book_alerter.db
# BOOK_ALERTER_DATABASE_URL=sqlite:////app/data/book_alerter.db

# YAML config path. Default: /app/data/config.yaml
# BOOK_ALERTER_CONFIG_PATH=/app/data/config.yaml

# Vite SPA build dir. Default: /app/web/dist (baked into the image — leave
# alone unless you mount a custom frontend build).
# BOOK_ALERTER_WEB_DIST=/app/web/dist

# ---------------------------------------------------------------------------
# Optional HTTP Basic auth (src/book_alerter/auth.py).
#
# Off by default — the NAS deploy posture is Tailscale-only and the network
# itself is the auth boundary. Set BOTH to non-empty values to enable.
# Useful for non-Tailscale deployments or as defence in depth.
# ---------------------------------------------------------------------------

# APP_BASIC_AUTH_USER=
# APP_BASIC_AUTH_PASS=

# ---------------------------------------------------------------------------
# ntfy push notifications (src/book_alerter/notifications/ntfy.py).
#
# The ntfy notifier is configured via data/config.yaml, NOT via env vars —
# that file supports ${VAR} interpolation, so the convention is to put the
# topic / server here and reference them from config.yaml:
#
#   notifications:
#     channels:
#       ntfy:
#         enabled: true
#         server: ${NTFY_SERVER}
#         topic:  ${NTFY_TOPIC}
#
# Without that interpolation in config.yaml these variables are unused.
# ---------------------------------------------------------------------------

# NTFY_SERVER=https://ntfy.sh
# NTFY_TOPIC=

# ---------------------------------------------------------------------------
# Reserved for future notification channels mentioned in the spec but not yet
# wired into the config schema. Setting these today is a no-op; kept here so
# the .env doesn't need a rewrite when they land.
# ---------------------------------------------------------------------------

# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# PUSHOVER_USER_KEY=
# PUSHOVER_APP_TOKEN=
# SENTRY_DSN=

# ---------------------------------------------------------------------------
# Misc.
# ---------------------------------------------------------------------------

# Container timezone — affects log timestamps and quiet-hours scheduling if
# you don't set the IANA tz in config.yaml.notifications.quiet_hours.tz.
# TZ=Europe/London
