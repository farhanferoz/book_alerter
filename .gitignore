# Runtime data
data/
!data/.gitkeep

# Persistent Playwright profile dirs (cookies, local storage) — already
# covered by the blanket `data/` rule above; called out explicitly because
# they hold session state that must never be committed, mode 700 on disk.
data/browser-profiles/
# Failure-page HTML dumps, written only on a failed or unrecognised scrape
# and bounded by the janitor. Same story: already covered by `data/`.
data/debug/

# Scenario artifacts (test DB + per-scenario config)
tests/scenarios/.test.db
tests/scenarios/.scenario_config.yaml
tests/scenarios/screenshots/

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
.uv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ty_cache/
*.egg-info/
dist/
build/

# Node / Vite
node_modules/
web/dist/
web/.vite/

# Env / secrets
.env
.env.local
*.local

# Editor
.vscode/
.idea/
*.swp
.DS_Store
.antigravitycli/

# Claude
.claude/settings.local.json

# Hypothesis' example database — regenerated on demand, never shared.
.hypothesis/
